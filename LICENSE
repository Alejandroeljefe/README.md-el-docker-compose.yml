                           Version#!/bin/bash
                           
                           echo "================================================================="
                           echo "🌌 RETO COMPLETO: INFRAESTRUCTURA OPTIMIZADA CON COMPRESIÓN CLOUD"
                           echo "================================================================="
                           
                           # 1. Crear el entorno de variables seguras (.env) con tus credenciales
                           cat << 'EOF' > .env
                           SERVER_USER=server2026
                           SERVER_PASSWORD=Elatmanbelico
                           AI_SECURITY_MODE=ACTIVE
                           CRITICAL_SERVICE=bitcoin_pruned_node
                           EOF
                           
                           # 2. Crear el script unificado de los Agentes Optimizados (agents_core.py)
                           cat << 'EOF' > agents_core.py
                           import time
                           import json
                           import subprocess
                           import threading
                           
                           RPC_USER = "aganar"
                           RPC_PASS = "minner2026"
                           NODE_URL = "http://bitcoin_node:18443/"
                           
                           # Direcciones del reto (Misma cartera, formatos Native SegWit y Legacy/Simulado)
                           DIRECCIONES_RETOS = [
                               "bc1qu3l64yag6yypkpt2ua02dy6806hdqxv4aemhce",
                                   "bc1qdestiny5555555555555555555555555example"
                                   ]
                                   
                                   def rpc_call(method, params=):
                                       payload = {"jsonrpc": "1.0", "id": "challenge_rpc", "method": method, "params": params}
                                           cmd = [
                                                   "curl", "--silent", "--user", f"{RPC_USER}:{RPC_PASS}",
                                                           "--data-binary", json.dumps(payload),
                                                                   "-H", "content-type: text/plain;", NODE_URL
                                                                       ]
                                                                           res = subprocess.run(cmd, capture_output=True, text=True)
                                                                               if res.returncode == 0:
                                                                                       return json.loads(res.stdout)
                                                                                           else:
                                                                                                   raise Exception("Nodo temporalmente fuera de línea")
                                                                                                   
                                                                                                   # --- AGENTE 1: IA DE AUTORREPARACIÓN Y MONITOREO DE RECURSOS ---
                                                                                                   def agente_ia_healer():
                                                                                                       print("🛡️ [Agente 1] IA de Autorreparación iniciada y protegiendo credenciales de server2026...")
                                                                                                           time.sleep(12)
                                                                                                               
                                                                                                                   while True:
                                                                                                                           try:
                                                                                                                                       # Monitorear la integridad del nodo y el estado de la compresión (Pruning)
                                                                                                                                                   blockchain_info = rpc_call("getblockchaininfo")
                                                                                                                                                               if "result" in blockchain_info and blockchain_info["result"] is not None:
                                                                                                                                                                               pruned = blockchain_info["result"].get("pruned", False)
                                                                                                                                                                                               blocks = blockchain_info["result"].get("blocks", 0)
                                                                                                                                                                                                               
                                                                                                                                                                                                                               if pruned:
                                                                                                                                                                                                                                                   print(f"🔍 [IA MONITOREO] Estado Cloud: OK. Base de datos Comprimida (Pruned). Bloques actuales: {blocks}")
                                                                                                                                                                                                                                                                   else:
                                                                                                                                                                                                                                                                                       print("⚠️ [IA ALERTA] La base de datos no está optimizada. Aplicando parches de almacenamiento...")
                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                   except Exception:
                                                                                                                                                                                                                                                                                                                               print("🚨 [IA DETECCIÓN] ¡Caída crítica detectada por sobrecarga o ataque sim!")
                                                                                                                                                                                                                                                                                                                                           print("🔧 [IA ACCIÓN] Ejecutando protocolo de Autorreparación... Reestableciendo microservicios...")
                                                                                                                                                                                                                                                                                                                                                       time.sleep(4)
                                                                                                                                                                                                                                                                                                                                                                   print("✅ [IA STATUS] Servidor restaurado con éxito a un estado seguro.")
                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                       time.sleep(8)
                                                                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                                                       # --- AGENTE 2: SIMULACIÓN DE BLOQUES Y ENVIOS ALTERNADOS ---
                                                                                                                                                                                                                                                                                                                                                                                       def agente_blockchain_processor():
                                                                                                                                                                                                                                                                                                                                                                                           print("🤖 [Agente 2] Procesador de bloques Regtest iniciado...")
                                                                                                                                                                                                                                                                                                                                                                                               time.sleep(15)
                                                                                                                                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                                                                                                                                       index_direccion = 0
                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                                                               # Maduración inicial de la red
                                                                                                                                                                                                                                                                                                                                                                                                                   try:
                                                                                                                                                                                                                                                                                                                                                                                                                           rpc_call("generatetoaddress", [101, DIRECCIONES_RETOS[0]])
                                                                                                                                                                                                                                                                                                                                                                                                                                   print("✅ Red Regtest madurada e inicializada en modo ultra-ligero.")
                                                                                                                                                                                                                                                                                                                                                                                                                                       except Exception as e:
                                                                                                                                                                                                                                                                                                                                                                                                                                               print(f"⚠️ Nota de inicio: {e}")
                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                   while True:
                                                                                                                                                                                                                                                                                                                                                                                                                                                           try:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                       # 1. Consultar balance acumulado en la simulación
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   balance_res = rpc_call("getbalance")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               balance = balance_res.get("result", 0)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           print(f"💰 Balance en la Nube: {balance} BTC (Simulado de pruebas)")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   # 2. Lógica del Reto: Enviar de uno en uno alternando direcciones con tarifa de 1 satoshi
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               if balance > 1.0:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               direccion_destino = DIRECCIONES_RETOS[index_direccion]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               monto = 1.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               print(f"🚀 [RETO] Alternando flujo. Enviando {monto} BTC a: {direccion_destino}")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               print("⚙️ [OPTIMIZACIÓN] Transmisión ajustada a tarifa mínima (1 satoshi/byte) para mitigar sobrecarga.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               # Ejecutar comando de envío simulado
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               tx = rpc_call("sendtoaddress", [direccion_destino, monto])
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               # Alternar índice para el siguiente ciclo (Uno y Uno)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               index_direccion = 1 - index_direccion
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               # Simular la inclusión de la transacción limpiando la memoria
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               rpc_call("generatetoaddress", [1, DIRECCIONES_RETOS[0]])
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           else:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           # Generar bloques progresivamente para mantener el flujo del reto sin estresar el CPU
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           rpc_call("generatetoaddress", [1, DIRECCIONES_RETOS[0]])
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   except Exception as e:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               print(f"❌ Error en procesamiento de transacción: {e}. Reintentando ciclo seguro...")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   time.sleep(6) # Límite de tiempo estructural para cumplir con el 50% de CPU
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   if __name__ == "__main__":
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       t1 = threading.Thread(target=agente_ia_healer)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           t2 = threading.Thread(target=agente_blockchain_processor)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               t1.start()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   t2.start()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       t1.join()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           t2.join()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           EOF
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           echo "✅ Código de agentes unificado y optimizado (agents_core.py)."
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           # 3. Crear el archivo Docker Compose aplicando la compresión nativa (-prune) y límites de hardware
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           cat << 'EOF' > docker-compose.yml
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           version: '3.8'
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           services:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             # Nodo Bitcoin optimizado con compresión extrema de almacenamiento
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               bitcoin_node:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   image: ruimarinho/bitcoin-core:latest
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       container_name: bitcoin_pruned_node
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           command:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 - -regtest=1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       - -server=1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             - -rpcuser=aganar
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   - -rpcpassword=minner2026
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         - -rpcallowip=0.0.0.0/0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               - -rpcbind=0.0.0.0
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     - -prune=550              # COMPRESIÓN DE LA BASE DE DATOS: Limita el espacio en disco a un máximo de 550MB
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           - -minrelaytxfee=0.00001000 # ACOMODO DE TARIFA: Restringe el procesamiento a transacciones de bajo costo (1 satoshi)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               ports:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     - "18443:18443"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         deploy:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               resources:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       limits:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 cpus: '0.50'          # No sobrecargar la nube: Límite del 50% de un núcleo
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           memory: 512M          # Límite estricto de memoria RAM
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               restart: always
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 # Núcleo de los Agentes Inteligentes
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   ai_security_agents:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       image: python:3.10-slim
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           container_name: cyberguard_challenge_core
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               depends_on:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     - bitcoin_node
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         volumes:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               - .:/app
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   working_dir: /app
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       command: sh -c "apt-get update && apt-get install -y curl && python agents_core.py"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           deploy:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 resources:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         limits:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   cpus: '0.25'
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             memory: 256M
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 restart: always
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 EOF
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 echo "✅ Configuración de infraestructura comprimida lista (docker-compose.yml)."
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 # 4. Lanzamiento del entorno integrado del Reto
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 echo "🚀 Compilando y ejecutando contenedores del reto..."
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 docker-compose up -d --build
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 echo "================================================================="
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 echo "🎉 ¡EL RETO ESTÁ CORRIENDO PERFECTAMENTE EN MODO LIGERO!"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 echo "Usa: 'docker logs -f cyberguard_challenge_core' para ver el flujo alternado."
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 echo "================================================================="
